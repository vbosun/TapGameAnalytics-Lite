[Unit]
Description=TapGame Analytics Lite read-only MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_USER
WorkingDirectory=/opt/TapGameAnalytics-Lite
EnvironmentFile=/opt/TapGameAnalytics-Lite/.env
ExecStart=/opt/TapGameAnalytics-Lite/.venv/bin/python -m tapgame_mcp --transport streamable-http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
