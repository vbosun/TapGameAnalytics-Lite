TAP_GAME_DATABASE_URL="sqlite:///data/tapgame.db"
TAP_GAME_COMPOSE_DATABASE_URL="sqlite:////data/tapgame.db"
TAP_GAME_OWNER_REPORT_DIR="data/owner_reports"
TAP_GAME_REPORT_TEMPLATE=""

# 国内默认镜像；境外或自建环境可替换为官方/私有镜像。
TAP_GAME_PYTHON_IMAGE="docker.m.daocloud.io/library/python:3.12-slim"
TAP_GAME_POSTGRES_IMAGE="docker.m.daocloud.io/library/postgres:17-alpine"
TAP_GAME_PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple"

# 仓库外的一行 Cookie 请求头值，必须包含 DC_XSRF_TOKEN。
TAP_GAME_DEVELOPER_COOKIE_FILE="secrets/developer.cookie"
TAP_GAME_COOKIE_REFRESH_COMMAND=""
TAP_GAME_COOKIE_REFRESH_TIMEOUT="120"

# 保守的请求控制。
TAP_GAME_OWNER_REQUEST_DELAY="1.0"
TAP_GAME_OWNER_TIMEOUT="30"
TAP_GAME_OWNER_MAX_RETRIES="3"
TAP_GAME_OWNER_BACKOFF_MAX="30"
TAP_GAME_OWNER_MAX_REQUESTS_PER_DAY="1000"

TAP_GAME_DAILY_HOUR="9"
TAP_GAME_ALERT_WEBHOOK=""

# REST API 默认仅监听本机；对外开放前必须设置长随机 Token。
TAP_GAME_API_HOST="127.0.0.1"
TAP_GAME_API_PORT="8780"
TAP_GAME_API_BIND="127.0.0.1"
TAP_GAME_API_TOKEN=""

# MCP 随包提供，但 Docker Compose 默认不启动。
TAP_GAME_MCP_HOST="127.0.0.1"
TAP_GAME_MCP_PORT="8765"
TAP_GAME_MCP_BIND="127.0.0.1"
TAP_GAME_MCP_ALLOWED_HOSTS="127.0.0.1:*,localhost:*"
TAP_GAME_MCP_ALLOWED_ORIGINS=""

# 可选 PostgreSQL：安装 [postgres] extra 后替换 DATABASE_URL。
TAP_GAME_POSTGRES_SCHEMA="tap_game"
# TAP_GAME_DATABASE_URL="postgresql://tapgame:PASSWORD@postgres:5432/tapgame"
# TAP_GAME_COMPOSE_DATABASE_URL="postgresql://tapgame:PASSWORD@postgres:5432/tapgame"
